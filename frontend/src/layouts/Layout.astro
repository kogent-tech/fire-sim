---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "fire-sim — FIRE / SWR Monte Carlo Simulator",
  description = "Open-source historical, Monte Carlo, and CAPE-based retirement withdrawal simulator.",
} = Astro.props;

// Set PUBLIC_BRAND=kogent at build time for the Kogent.Tech-hosted instance
// (mc.kogent.tech). Self-hosted/default builds get the plain fire-sim look.
const brand = import.meta.env.PUBLIC_BRAND ?? "default";
---

<!doctype html>
<html lang="en" data-brand={brand}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      brand === "kogent" && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&display=swap"
            rel="stylesheet"
          />
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div>
          <h1>fire-sim</h1>
          <p>Historical, Monte Carlo &amp; CAPE-based Safe Withdrawal Rate simulator</p>
        </div>
        {
          brand === "kogent" && (
            <a class="kogent-badge" href="https://kogent.tech" target="_blank" rel="noreferrer">
              <img src="/kogent-mark.svg" alt="" />
              An open project by Kogent.Tech
            </a>
          )
        }
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Open source on
        <a href="https://github.com/kogent-tech/fire-sim" target="_blank" rel="noreferrer">GitHub</a>
        · MIT licensed · Not investment advice.
      </p>
    </footer>
  </body>
</html>
